FROM node:22-slim

# Image metadata
LABEL org.openclaw.image.type="openclaw-agent"
LABEL org.openclaw.image.description="OpenClaw agent in constrained execution environment"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    python3 \
    python3-pip \
    xxd \
    file \
    && rm -rf /var/lib/apt/lists/*

# Install OpenClaw globally (much faster than building from source)
RUN npm install -g openclaw@latest

# Install Python wrapper dependencies (system-wide, no venv)
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip install --no-cache-dir httpx pypdf pymupdf

# Create workspace and agent user (UID 1001, since 1000 is 'node' in base image)
RUN mkdir -p /workspace /tmp/agent /root/.openclaw && \
    useradd -m -u 1001 -s /bin/bash agent && \
    chown -R 1001:1001 /workspace /tmp/agent

# Copy adapter
COPY taskforge-adapter.py /opt/openclaw/taskforge-adapter.py
COPY openclaw-wrapper.py /opt/openclaw-wrapper.py
COPY openclaw-wrapper.js /opt/openclaw-wrapper.js
RUN chmod +x /opt/openclaw-wrapper.py /opt/openclaw-wrapper.js

# Set up workspace
WORKDIR /workspace
USER agent

# Environment configuration
ENV NODE_ENV=production \
    WORKSPACE=/workspace \
    PYTHONUNBUFFERED=1

# Use TaskForge adapter for native agentic loop
ENTRYPOINT ["python3", "/opt/openclaw/taskforge-adapter.py"]
