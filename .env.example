# OpenClaw Contained — Environment Configuration
# Copy this file to .env and adjust values as needed.

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_PASSWORD=openclaw_pass

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# URL where Ollama is reachable from Docker containers.
# - Linux host (Docker Engine): http://host.docker.internal:11434
# - Windows host + TaskForge in WSL2: use the Windows LAN IP, e.g.
#     OLLAMA_URL=http://192.168.1.20:11434
#   host.docker.internal points at the WSL VM, not Windows.
#   Run `make test-ollama` to detect a working URL and
#   `make set-ollama-url` to write it here and update the running control-plane.
OLLAMA_URL=http://host.docker.internal:11434

# Optional — set keys for the providers you want to use.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Decision-model triage (cheap pre-screen before the deep review).
# Uses Ollama's System One endpoint: POST {OLLAMA_URL}/v1/systemone.
# Requires Ollama >= 0.40.4 and the model pulled on the host, e.g.:
#   ollama pull kev:0.8b-q8_0
# Triage can only pass or escalate; it never fails a node. When it is
# disabled/unavailable/uncertain, the deep review runs as before.
# DECISION_TRIAGE_ENABLED=true
# DECISION_TRIAGE_PROVIDER=ollama
# DECISION_TRIAGE_MODEL=kev:0.8b-q8_0
# DECISION_TRIAGE_THRESHOLD=0.20
# DECISION_TRIAGE_SAMPLE_RATE=0.05
# ============================================================================== 
# AGENT EXECUTION ENVIRONMENT (SANDBOX) 
# ============================================================================== 
# WARNING: Running AI agents in standard Docker-in-Docker (DinD) is DANGEROUS  
# for production. It requires privileged mode, meaning a compromised agent  
# can potentially gain root access to the host machine.
#
# Available Options:
#   - gvisor          : (RECOMMENDED) Uses runsc for strict user-space kernel  
#                       isolation. Requires gVisor installed on the host.
#   - insecure-dind   : Standard Docker container. Easy for local testing,  
#                       but strictly NOT recommended for public/production use.
#   - dedicated-vm    : (Future) Spawns isolated Firecracker microVMs.
# 
AGENT_SANDBOX_MODE=insecure-dind

# =============================================================================
# CREDENTIAL GATEWAY / OPENBAO
# =============================================================================
# OpenBao is the PRIMARY credential store (KV v2 at secret/credentials/<name>).
# The local JSON files under config/credentials/ are a deprecated fallback and
# cookie-jar location only.
OPENBAO_ENABLED=true
OPENBAO_ADDR=http://openbao:8200
OPENBAO_TOKEN=openclaw-root

# =============================================================================
# FRONTEND
# =============================================================================
# API base URL the browser uses to reach the control-plane.
# Override when deploying behind a reverse-proxy or on a remote host.
API_URL=http://localhost:8000
