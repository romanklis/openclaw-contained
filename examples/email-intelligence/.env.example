# Email Intelligence Demo — environment (copy to .env to override defaults)
# Defaults are local-demo only; do not reuse anywhere real.

# --- PostgreSQL (email-postgres) ---
POSTGRES_USER=email_admin
POSTGRES_PASSWORD=email_admin_pwd_demo
POSTGRES_DB=email_intelligence
# Least-privilege role used by the agent nodes (no DELETE/DDL).
TASKFORGE_WRITER_PASSWORD=taskforge_writer_pwd_demo
# Backend service account (reads all, writes runs/settings only).
EMAIL_APP_PASSWORD=email_app_pwd_demo

# --- Mirror mailbox (greenmail) ---
# The credential-gateway registers `taskforge-mail` with these values.
GREENMAIL_USER=taskforge@local.test
GREENMAIL_PASSWORD=taskforge-demo

# --- Platform integration ---
# Docker network of the running TaskForge platform (docker compose project name).
PLATFORM_NETWORK=openclaw-contained_openclaw-network

# --- Scheduler behavior ---
# manual  = button-triggered only (default; no automatic runs)
# interval = automatic starts every INTERVAL_SECONDS
SCHEDULER_MODE=manual
INTERVAL_SECONDS=60
SCHEDULER_POLL_SECONDS=5
# Set TARGET_DAG_ID after the planner builds the DAG (or use the dashboard field).
TARGET_DAG_ID=

# --- Scripts (host-side) ---
CONTROL_PLANE_URL=http://localhost:8000
SCHEDULER_URL=http://localhost:8096
DASHBOARD_URL=http://localhost:8095
