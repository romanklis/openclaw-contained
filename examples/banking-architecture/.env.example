# Banking Governance Demo — environment (copy to .env to override defaults)
# Defaults are local-demo only; do not reuse anywhere real.

# --- PostgreSQL (banking-postgres) ---
POSTGRES_USER=bank_admin
POSTGRES_PASSWORD=bank_admin_pwd_demo
# Technical (RBAC) role passwords
DB_AI_AGENT_PASSWORD=ai_agent_pwd_demo
DB_RISK_CONSUMER_PASSWORD=risk_pwd_demo
DB_GL_CONSUMER_PASSWORD=gl_pwd_demo
DB_CREDIT_OFFICER_PASSWORD=officer_pwd_demo

# --- MongoDB (banking-mongo) ---
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=mongo_admin_pwd_demo
MONGO_DMS_AI_USER=dms_ai
MONGO_DMS_AI_PASSWORD=dms_ai_pwd_demo
MONGO_DMS_ARCHIVIST_USER=dms_archivist
MONGO_DMS_ARCHIVIST_PASSWORD=dms_archivist_pwd_demo

# --- Platform integration ---
# Docker network of the running TaskForge platform (docker compose project name).
PLATFORM_NETWORK=openclaw-contained_openclaw-network

# --- TaskForge control plane (used by scripts) ---
CONTROL_PLANE_URL=http://localhost:8000
